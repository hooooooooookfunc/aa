			TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
			TitleLbl.ZIndex = 4
			TitleLbl.Parent = Holder

			local Btn = Instance.new("TextButton")
			Btn.Size = UDim2.new(0.45, 0, 0, 26)
			Btn.Position = UDim2.new(0.55, 0, 0.5, -13)
			Btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
			Btn.Font = Enum.Font.Jura
			Btn.TextSize = 13
			Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
			Btn.ZIndex = 4
			Btn.Parent = Holder
			addCorner(Btn, 4)

			local Stroke = Instance.new("UIStroke")
			Stroke.Color = Color3.fromRGB(0, 0, 0)
			Stroke.Thickness = 1.2
			Stroke.Parent = Btn

			local currentIndex = 1
			local opts = type(list) == "function" and list() or list
			for i, v in ipairs(opts) do
				if tostring(v) == tostring(default) then currentIndex = i break end
			end
			
			Btn.Text = tostring(opts[currentIndex] or "Default")

			Btn.MouseButton1Click:Connect(function()
				playSound()
				if type(list) == "function" then opts = list() end
				if #opts == 0 then return end
				currentIndex = currentIndex + 1
				if currentIndex > #opts then currentIndex = 1 end
				local val = opts[currentIndex]
				Btn.Text = tostring(val)
				callback(val)
			end)
		end

		return TabObj
	end

