local function addCorner(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 4)
	c.Parent = obj
	return c
end

local function hover(obj, props, time, style)
	local info = TweenInfo.new(time or 0.12, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	obj.MouseEnter:Connect(function()
		TweenService:Create(obj, info, props):Play()
	end)
	obj.MouseLeave:Connect(function()
		local reverse = {}
		for k, _ in pairs(props) do
			if k == "BackgroundTransparency" then reverse[k] = obj.BackgroundTransparency
			elseif k == "BackgroundColor3" then reverse[k] = obj.BackgroundColor3
			elseif k == "TextColor3" then reverse[k] = obj.TextColor3
			elseif k == "TextTransparency" then reverse[k] = obj.TextTransparency
			end
		end
		TweenService:Create(obj, info, reverse):Play()
	end)
end

