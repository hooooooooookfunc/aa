			tween:Play()

			TweenService:Create(notifStroke, TweenInfo.new(0.25), {
				Transparency = 1
			}):Play()

			tween.Completed:Connect(function()
				Notif:Destroy()
				activeNotifs[Notif] = nil
			end)
		end

		activeNotifs[Notif] = closeFn

		CloseIcon.MouseButton1Click:Connect(function()
			playSound()
			closeFn()
		end)

		TweenService:Create(Notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, notifWidth, 0, notifHeight)
		}):Play()

		if duration > 0 then
			task.delay(duration, function()
				closeFn()
			end)
		end

		return {
			Close = closeFn,
			Frame = Notif
		}
	end

