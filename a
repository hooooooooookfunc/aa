            tween(win, 0.25, { Size = r })
        end
    end)

    if opts.Keybind then
        UIS.InputBegan:Connect(function(input)
            if input.KeyCode == opts.Keybind then
                win.Visible = not win.Visible
            end
        end)
    end

    win.BackgroundTransparency = 1
    tween(win, 1.2, { BackgroundTransparency = 0.05 })

    local tabs = {}
    local activeTab = nil
    local WindowObj = { Gui = gui, Window = win, Tabs = tabs }

    function WindowObj:Notify(nOpts)
        nOpts = nOpts or {}
        initNotify()

        local nFrame = Instance.new("Frame")
        nFrame.Size = UDim2.new(1, 0, 0, 50)
        nFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        nFrame.BackgroundTransparency = 0.1
        nFrame.BorderSizePixel = 0
        nFrame.ZIndex = 101
        nFrame.Parent = notifyContainer
        corner(nFrame, 6)
        addRichGreyGradient(nFrame)
        blur(nFrame)

        local nTitle = Instance.new("TextLabel")
        nTitle.Size = UDim2.new(1, -12, 0, 18)
        nTitle.Position = UDim2.new(0, 8, 0, 4)
        nTitle.BackgroundTransparency = 1
        nTitle.Font = font
        nTitle.Text = nOpts.Title or "Notification"
        nTitle.TextColor3 = Color3.new(1, 1, 1)
        nTitle.TextSize = 12
        nTitle.TextXAlignment = Enum.TextXAlignment.Left
        nTitle.ZIndex = 102
        nTitle.Parent = nFrame

        local nText = Instance.new("TextLabel")
        nText.Size = UDim2.new(1, -12, 0, 22)
        nText.Position = UDim2.new(0, 8, 0, 22)
        nText.BackgroundTransparency = 1
        nText.Font = font
        nText.Text = nOpts.Text or ""
        nText.TextColor3 = Color3.fromRGB(200, 200, 200)
        nText.TextSize = 11
        nText.TextXAlignment = Enum.TextXAlignment.Left
        nText.ZIndex = 102
        nText.Parent = nFrame

        task.delay(nOpts.Duration or 3, function()
            tween(nFrame, 0.4, { BackgroundTransparency = 1 })
            tween(nTitle, 0.4, { TextTransparency = 1 })
            tween(nText, 0.4, { TextTransparency = 1 })
            task.wait(0.4)
            nFrame:Destroy()
        end)
    end

    local function selectTab(name)
        if activeTab then
            activeTab.Page.Visible = false
            tween(activeTab.Button, 0.15, {
                BackgroundTransparency = 0.5,
                TextColor3 = Color3.fromRGB(170, 170, 170),
            })
        end
        local t = tabs[name]
        if not t then return end
        activeTab = t
        t.Page.Visible = true
        tween(t.Button, 0.15, {
            BackgroundTransparency = 0.2,
            TextColor3 = Color3.new(1, 1, 1),
        })
    end

    function WindowObj:CreateTab(name)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 26)
        btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        btn.BackgroundTransparency = 0.5
        btn.BorderSizePixel = 0
        btn.Font = font
        btn.Text = name
        btn.TextColor3 = Color3.fromRGB(170, 170, 170)
        btn.TextSize = 12
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.AutoButtonColor = false
        btn.ZIndex = 6
        btn.Parent = tabBar
        corner(btn, 5)

        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0, 8)
        pad.Parent = btn

        local page = Instance.new("ScrollingFrame")
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.Size = UDim2.fromScale(1, 1)
        page.ScrollBarThickness = 3
        page.ScrollBarImageColor3 = Color3.fromRGB(110, 110, 110)
        page.CanvasSize = UDim2.new(0, 0, 0, 0)
        page.Visible = false
        page.ZIndex = 6
        page.Parent = pageArea

        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 6)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = page

        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 8)
        end)

        local tabObj = { Button = btn, Page = page, Name = name }
        tabs[name] = tabObj

        btn.MouseButton1Click:Connect(function() selectTab(name) end)
        if not activeTab then selectTab(name) end

        local TabObj = { Page = page, Name = name }

        function TabObj:CreateToggle(o)
            o = o or {}
            local state = o.Default or false
            local row = Instance.new("TextButton")
            row.Size = UDim2.new(1, 0, 0, 24)
            row.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            row.BackgroundTransparency = 0.4
            row.BorderSizePixel = 0
            row.AutoButtonColor = false
            row.Text = ""
            row.ZIndex = 7
            row.Parent = self.Page
            corner(row, 5)
            addRichGreyGradient(row)

            local dot = Instance.new("Frame")
            dot.Size = UDim2.new(0, 12, 0, 12)
            dot.Position = UDim2.new(0, 6, 0.5, -6)
            dot.BackgroundColor3 = state and Color3.fromRGB(80, 200, 80) or Color3.fromRGB(110, 110, 110)
            dot.BorderSizePixel = 0
            dot.ZIndex = 8
            dot.Parent = row
            corner(dot, 6)

            local lab = Instance.new("TextLabel")
            lab.BackgroundTransparency = 1
            lab.Size = UDim2.new(1, -30, 1, 0)
            lab.Position = UDim2.new(0, 24, 0, 0)
            lab.Font = font
            lab.Text = o.Name or o.Text or "Toggle"
            lab.TextColor3 = Color3.new(1, 1, 1)
            lab.TextSize = 12
            lab.TextXAlignment = Enum.TextXAlignment.Left
            lab.ZIndex = 8
            lab.Parent = row

            local function set(v)
                state = v
                dot.BackgroundColor3 = state and Color3.fromRGB(80, 200, 80) or Color3.fromRGB(110, 110, 110)
                if o.Callback then task.spawn(o.Callback, state) end
            end
            row.MouseButton1Click:Connect(function() set(not state) end)
            set(state)
            return { Set = set, Get = function() return state end }
        end

        function TabObj:CreateCycle(o)
            o = o or {}
            local options = o.Options or {}
            local selected = o.Default or options[1]
            local open = false

            local f = Instance.new("Frame")
            f.Size = UDim2.new(1, 0, 0, 24)
            f.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            f.BackgroundTransparency = 0.4
            f.BorderSizePixel = 0
            f.ClipsDescendants = true
            f.ZIndex = 15
            f.Parent = self.Page
            corner(f, 5)
            addRichGreyGradient(f)

            local header = Instance.new("TextButton")
            header.Size = UDim2.fromScale(1, 1)
            header.BackgroundTransparency = 1
            header.Text = ""
            header.ZIndex = 16
            header.Parent = f

            local lab = Instance.new("TextLabel")
            lab.BackgroundTransparency = 1
            lab.Size = UDim2.new(1, -20, 1, 0)
            lab.Position = UDim2.new(0, 8, 0, 0)
            lab.Font = font
            lab.Text = (o.Name or o.Text or "Option") .. ": " .. tostring(selected)
            lab.TextColor3 = Color3.new(1, 1, 1)
            lab.TextSize = 12
            lab.TextXAlignment = Enum.TextXAlignment.Left
            lab.ZIndex = 16
            lab.Parent = f

            local arrow = Instance.new("TextLabel")
            arrow.BackgroundTransparency = 1
            arrow.Size = UDim2.new(0, 16, 1, 0)
            arrow.Position = UDim2.new(1, -18, 0, 0)
            arrow.Font = font
            arrow.Text = "v"
            arrow.TextColor3 = Color3.new(1, 1, 1)
            arrow.TextSize = 12
            arrow.ZIndex = 16
            arrow.Parent = f

            local list = Instance.new("Frame")
            list.BackgroundTransparency = 1
            list.Size = UDim2.new(1, 0, 0, 0)
            list.Position = UDim2.new(0, 0, 0, 24)
            list.ZIndex = 15
            list.Parent = f

            local ll = Instance.new("UIListLayout")
            ll.Padding = UDim.new(0, 2)
            ll.Parent = list

            local function rebuild()
                for _, c in ipairs(list:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                for _, opt in ipairs(options) do
                    local b = Instance.new("TextButton")
                    b.Size = UDim2.new(1, 0, 0, 20)
                    b.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                    b.BackgroundTransparency = 0.4
                    b.BorderSizePixel = 0
                    b.Font = font
                    b.Text = tostring(opt)
                    b.TextColor3 = Color3.new(1, 1, 1)
                    b.TextSize = 11
                    b.TextXAlignment = Enum.TextXAlignment.Left
                    b.ZIndex = 16
                    b.Parent = list
                    corner(b, 4)
                    b.MouseButton1Click:Connect(function()
                        selected = opt
                        lab.Text = (o.Name or o.Text or "Option") .. ": " .. tostring(selected)
                        if o.Callback then task.spawn(o.Callback, selected) end
                        open = false
                        tween(f, 0.2, { Size = UDim2.new(1, 0, 0, 24) })
                    end)
                end
            end
            rebuild()

            header.MouseButton1Click:Connect(function()
                open = not open
                tween(f, 0.25, { Size = UDim2.new(1, 0, 0, open and (24 + (#options * 22)) or 24) })
            end)

            return {
                Set = function(v)
                    selected = v
                    lab.Text = (o.Name or o.Text or "Option") .. ": " .. tostring(v)
                    if o.Callback then task.spawn(o.Callback, v) end
                end,
                Get = function() return selected end,
            }
        end

        function TabObj:CreateSlider(o)
            o = o or {}
            local min, max = o.Min or 0, o.Max or 100
            local value = o.Default or min
            local suffix = o.Suffix or ""

            local f = Instance.new("Frame")
            f.Size = UDim2.new(1, 0, 0, 36)
            f.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            f.BackgroundTransparency = 0.4
            f.BorderSizePixel = 0
            f.ZIndex = 7
            f.Parent = self.Page
            corner(f, 5)
            addRichGreyGradient(f)

            local lab = Instance.new("TextLabel")
            lab.BackgroundTransparency = 1
            lab.Size = UDim2.new(1, -10, 0, 16)
            lab.Position = UDim2.new(0, 6, 0, 2)
            lab.Font = font
            lab.Text = (o.Name or o.Text or "Slider") .. "  •  " .. tostring(value) .. suffix
            lab.TextColor3 = Color3.new(1, 1, 1)
            lab.TextSize = 11
            lab.TextXAlignment = Enum.TextXAlignment.Left
            lab.ZIndex = 8
            lab.Parent = f

            local track = Instance.new("Frame")
            track.Size = UDim2.new(1, -12, 0, 4)
            track.Position = UDim2.new(0, 6, 1, -10)
            track.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
            track.BorderSizePixel = 0
            track.ZIndex = 8
            track.Parent = f
            corner(track, 2)

            local fill = Instance.new("Frame")
            fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
            fill.BackgroundColor3 = Color3.new(1, 1, 1)
            fill.BorderSizePixel = 0
            fill.ZIndex = 9
            fill.Parent = track
            corner(fill, 2)

            local dragging = false
            local function upd(x)
                local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                value = math.floor(min + (max - min) * rel + 0.5)
                fill.Size = UDim2.new(rel, 0, 1, 0)
                lab.Text = (o.Name or o.Text or "Slider") .. "  •  " .. tostring(value) .. suffix
                if o.Callback then task.spawn(o.Callback, value) end
            end
            track.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1
                or i.UserInputType == Enum.UserInputType.Touch then
                    dragging = true; upd(i.Position.X)
                end
            end)
            UIS.InputChanged:Connect(function(i)
                if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
                or i.UserInputType == Enum.UserInputType.Touch) then upd(i.Position.X) end
            end)
            UIS.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1
                or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
            end)

            return {
                Set = function(v)
                    value = math.clamp(v, min, max)
                    local rel = (value - min) / (max - min)
                    fill.Size = UDim2.new(rel, 0, 1, 0)
                    lab.Text = (o.Name or o.Text or "Slider") .. "  •  " .. tostring(value) .. suffix
                    if o.Callback then task.spawn(o.Callback, value) end
                end,
                Get = function() return value end,
            }
        end

        function TabObj:CreateTextBox(o)
            o = o or {}
            local f = Instance.new("Frame")
            f.Size = UDim2.new(1, 0, 0, 36)
            f.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            f.BackgroundTransparency = 0.4
            f.BorderSizePixel = 0
            f.ZIndex = 7
            f.Parent = self.Page
            corner(f, 5)
            addRichGreyGradient(f)

            local box = Instance.new("TextBox")
            box.BackgroundTransparency = 1
            box.Size = UDim2.new(1, -12, 1, -4)
            box.Position = UDim2.new(0, 6, 0, 2)
            box.Font = font
            box.PlaceholderText = o.Placeholder or o.Name or "Type..."
            box.Text = o.Default or ""
            box.TextColor3 = Color3.new(1, 1, 1)
            box.PlaceholderColor3 = Color3.fromRGB(150, 150, 150)
            box.TextSize = 12
            box.TextXAlignment = Enum.TextXAlignment.Left
            box.ClearTextOnFocus = false
            box.ZIndex = 8
            box.Parent = f

            box.FocusLost:Connect(function()
                if o.Callback then task.spawn(o.Callback, box.Text) end
            end)
            return {
                Set = function(t) box.Text = t end,
                Get = function() return box.Text end,
            }
        end

        function TabObj:CreateButton(o)
            o = o or {}
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, 0, 0, 24)
            b.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            b.BackgroundTransparency = 0.4
            b.BorderSizePixel = 0
            b.Font = font
            b.Text = o.Name or o.Text or "Button"
            b.TextColor3 = Color3.new(1, 1, 1)
            b.TextSize = 12
            b.AutoButtonColor = false
            b.ZIndex = 7
            b.Parent = self.Page
            corner(b, 5)
            addRichGreyGradient(b)
            b.MouseEnter:Connect(function() tween(b, 0.2, { BackgroundTransparency = 0.2 }) end)
            b.MouseLeave:Connect(function() tween(b, 0.2, { BackgroundTransparency = 0.4 }) end)
            b.MouseButton1Click:Connect(function() if o.Callback then task.spawn(o.Callback) end end)
            return { Instance = b }
        end

        return TabObj
    end

    return WindowObj
end

return Astralis
