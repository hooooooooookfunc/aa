		function TabObj:CreateSlider(options)
			local name = options.Name or "Slider"
			local min = options.Min or 0
			local max = options.Max or 100
			local default = options.Default or min
			local callback = options.Callback or function() end

			local Holder = Instance.new("Frame")
			Holder.Size = UDim2.new(1, 0, 0, 36)
			Holder.BackgroundTransparency = 1
			Holder.ZIndex = 3
			Holder.Parent = TabPage

			-- Title Label (Left)
			local TitleLbl = Instance.new("TextLabel")
			TitleLbl.Size = UDim2.new(0.5, 0, 1, 0)
			TitleLbl.BackgroundTransparency = 1
			TitleLbl.Text = name
			TitleLbl.Font = Enum.Font.Jura
			TitleLbl.TextSize = 15
			TitleLbl.TextColor3 = Color3.fromRGB(225, 225, 225)
			TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
			TitleLbl.ZIndex = 4
			TitleLbl.Parent = Holder

			-- Chunky Slider Track (Right side)
			local Track = Instance.new("Frame")
			Track.Size = UDim2.new(0, 150, 0, 26)
			Track.Position = UDim2.new(1, -150, 0.5, -13)
			Track.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
			Track.ZIndex = 4
			Track.Parent = Holder
			addCorner(Track, 6)

			local TrackStroke = Instance.new("UIStroke")
			TrackStroke.Color = Color3.fromRGB(0, 0, 0)
			TrackStroke.Thickness = 1.2
			TrackStroke.Parent = Track

			local pct = math.clamp((default - min) / (max - min), 0, 1)
			
			-- Dark Grey Fill
			local Fill = Instance.new("Frame")
			Fill.Size = UDim2.new(pct, 0, 1, 0)
			Fill.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
			Fill.ZIndex = 5
			Fill.Parent = Track
			addCorner(Fill, 6)

			-- Value Text (Centered inside the track)
			local ValLbl = Instance.new("TextLabel")
			ValLbl.Size = UDim2.new(1, 0, 1, 0)
			ValLbl.BackgroundTransparency = 1
			ValLbl.Text = tostring(default)
			ValLbl.Font = Enum.Font.Jura
			ValLbl.TextSize = 13
			ValLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
			ValLbl.ZIndex = 6
			ValLbl.Parent = Track

			-- Hitbox
			local Btn = Instance.new("TextButton")
			Btn.Size = UDim2.new(1, 0, 1, 0)
			Btn.BackgroundTransparency = 1
			Btn.Text = ""
			Btn.ZIndex = 7
			Btn.Parent = Track

			local sliding = false
			local function update(input)
				local x = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
				local val = math.floor(min + (max - min) * x)
				Fill.Size = UDim2.new(x, 0, 1, 0)
				ValLbl.Text = tostring(val)
				callback(val)
			end

			Btn.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true update(i) end end)
			UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end end)
			UserInputService.InputChanged:Connect(function(i) if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then update(i) end end)
		end

