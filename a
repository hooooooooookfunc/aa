			SVBlack.BorderSizePixel = 0
			SVBlack.ZIndex = 23
			SVBlack.Parent = SV

			local BlackGradient = Instance.new("UIGradient")
			BlackGradient.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, 0)
			})
			BlackGradient.Rotation = 90
			BlackGradient.Parent = SVBlack

			local SVMarker = Instance.new("Frame")
			SVMarker.Size = UDim2.new(0, 10, 0, 10)
			SVMarker.AnchorPoint = Vector2.new(0.5, 0.5)
			SVMarker.BackgroundColor3 = Color3.new(1, 1, 1)
			SVMarker.BorderSizePixel = 0
			SVMarker.ZIndex = 24
			SVMarker.Parent = SV

			addCorner(SVMarker, 5)

			local SVStroke = Instance.new("UIStroke")
			SVStroke.Color = Color3.new(0, 0, 0)
			SVStroke.Thickness = 1
			SVStroke.Parent = SVMarker

			local Hue = Instance.new("Frame")
			Hue.Size = UDim2.new(1, 0, 0, 12)
			Hue.Position = UDim2.new(0, 0, 0, 158)
			Hue.BackgroundColor3 = Color3.new(1, 1, 1)
			Hue.BorderSizePixel = 0
			Hue.ZIndex = 21
			Hue.Parent = Popup

			addCorner(Hue, 4)

			local HueGradient = Instance.new("UIGradient")
			HueGradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
				ColorSequenceKeypoint.new(0.166, Color3.fromRGB(255, 255, 0)),
				ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
				ColorSequenceKeypoint.new(0.500, Color3.fromRGB(0, 255, 255)),
				ColorSequenceKeypoint.new(0.666, Color3.fromRGB(0, 0, 255)),
				ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
				ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0))
			})
			HueGradient.Parent = Hue

			local HueMarker = Instance.new("Frame")
			HueMarker.Size = UDim2.new(0, 6, 0, 16)
			HueMarker.AnchorPoint = Vector2.new(0.5, 0.5)
			HueMarker.BackgroundColor3 = Color3.new(1, 1, 1)
			HueMarker.BorderSizePixel = 0
			HueMarker.ZIndex = 22
			HueMarker.Parent = Hue

			addCorner(HueMarker, 2)

			local HexBox = Instance.new("TextBox")
			HexBox.Size = UDim2.new(1, -72, 0, 28)
			HexBox.Position = UDim2.new(0, 0, 0, 182)
			HexBox.BackgroundColor3 = Theme.ButtonBackground
			HexBox.BorderSizePixel = 0
			HexBox.Text = "#" .. currentColor:ToHex()
			HexBox.PlaceholderText = "#RRGGBB"
			HexBox.PlaceholderColor3 = Theme.DescriptionColor
			HexBox.Font = Theme.Font
			HexBox.TextSize = 12
			HexBox.TextColor3 = Theme.TextColor
			HexBox.ClearTextOnFocus = false
			HexBox.TextXAlignment = Enum.TextXAlignment.Left
			HexBox.ZIndex = 21
			HexBox.Parent = Popup

			addCorner(HexBox, 4)

			local HexPadding = Instance.new("UIPadding")
			HexPadding.PaddingLeft = UDim.new(0, 8)
			HexPadding.Parent = HexBox

			local ResetBtn = Instance.new("TextButton")
			ResetBtn.Size = UDim2.new(0, 62, 0, 28)
			ResetBtn.Position = UDim2.new(1, -62, 0, 182)
			ResetBtn.BackgroundColor3 = Theme.ButtonBackground
			ResetBtn.BorderSizePixel = 0
			ResetBtn.Text = "Reset"
			ResetBtn.Font = Theme.Font
			ResetBtn.TextSize = 12
			ResetBtn.TextColor3 = Theme.ButtonTextColor
			ResetBtn.AutoButtonColor = false
			ResetBtn.Modal = true
			ResetBtn.ZIndex = 21
			ResetBtn.Parent = Popup

			addCorner(ResetBtn, 4)
			noSelect(ResetBtn)

			local hue, saturation, value = Color3.toHSV(currentColor)

			local function setColor(color, fireCallback)
				color = color or currentColor
				currentColor = color
				hue, saturation, value = Color3.toHSV(currentColor)
				Preview.BackgroundColor3 = currentColor
				SV.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
				SVMarker.Position = UDim2.new(saturation, 0, 1 - value, 0)
				HueMarker.Position = UDim2.new(hue, 0, 0.5, 0)
				HexBox.Text = "#" .. currentColor:ToHex()

				if fireCallback then
					callback(currentColor)
				end
			end

			local function updateFromSV(input)
				local x = math.clamp((input.Position.X - SV.AbsolutePosition.X) / SV.AbsoluteSize.X, 0, 1)
				local y = math.clamp((input.Position.Y - SV.AbsolutePosition.Y) / SV.AbsoluteSize.Y, 0, 1)
				saturation = x
				value = 1 - y
				setColor(Color3.fromHSV(hue, saturation, value), true)
			end

			local function updateFromHue(input)
				local x = math.clamp((input.Position.X - Hue.AbsolutePosition.X) / Hue.AbsoluteSize.X, 0, 1)
				hue = x
				setColor(Color3.fromHSV(hue, saturation, value), true)
			end

			local svDragging = false
			local hueDragging = false

			SV.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					svDragging = true
					updateFromSV(input)
				end
			end)

			Hue.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					hueDragging = true
					updateFromHue(input)
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if svDragging and (
					input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch
				) then
					updateFromSV(input)
				elseif hueDragging and (
					input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch
				) then
					updateFromHue(input)
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					svDragging = false
					hueDragging = false
				end
			end)

			HexBox.FocusLost:Connect(function()
				local hex = HexBox.Text:gsub("#", ""):gsub("%s+", "")
				if #hex == 6 and hex:match("^[%x]+$") then
					local r = tonumber(hex:sub(1, 2), 16)
					local g = tonumber(hex:sub(3, 4), 16)
					local b = tonumber(hex:sub(5, 6), 16)
					if r and g and b then
						setColor(Color3.fromRGB(r, g, b), true)
						return
					end
				end
				HexBox.Text = "#" .. currentColor:ToHex()
			end)

			ResetBtn.MouseButton1Click:Connect(function()
				playSound()
				setColor(default, true)
			end)

			local function setOpen(state)
				pickerOpen = state
				Popup.Visible = state

				if state then
					setColor(currentColor, false)
				end
			end

			Preview.MouseButton1Click:Connect(function()
				playSound()
				setOpen(not pickerOpen)
			end)

			setColor(currentColor, false)

			return {
				Set = function(_, color)
					if typeof(color) == "Color3" then
						setColor(color, true)
					end
				end,
				Get = function()
					return currentColor
				end,
				Open = function()
					setOpen(true)
				end,
				Close = function()
					setOpen(false)
				end
			}
		end

		return TabObj
	end

	WindowObj.Notify = function(self, opts)
		return createNotify(opts)
	end

	return WindowObj
end

return AstralisLib
