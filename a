		TextLbl.ZIndex = 6
		TextLbl.Parent = Notif

		local CloseIcon = Instance.new("TextButton")
		CloseIcon.Size = UDim2.new(0, 20, 0, 20)
		CloseIcon.Position = UDim2.new(1, -26, 0, 8)
		CloseIcon.BackgroundTransparency = 1
