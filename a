		noSelect(CloseIcon)

		CloseIcon.MouseEnter:Connect(function()
			TweenService:Create(CloseIcon, TweenInfo.new(0.12), {
				TextColor3 = Color3.fromRGB(240, 70, 70)
			}):Play()
		end)
		CloseIcon.MouseLeave:Connect(function()
			TweenService:Create(CloseIcon, TweenInfo.new(0.12), {
				TextColor3 = Theme.DescriptionColor
			}):Play()
		end)

		if #buttons > 0 then
			local BtnRow = Instance.new("Frame")
			BtnRow.Size = UDim2.new(1, -28, 0, 28)
			BtnRow.Position = UDim2.new(0, 14, 0, 56)
			BtnRow.BackgroundTransparency = 1
			BtnRow.ZIndex = 6
			BtnRow.Parent = Notif

			local BtnLayout = Instance.new("UIListLayout")
			BtnLayout.FillDirection = Enum.FillDirection.Horizontal
			BtnLayout.SortOrder = Enum.SortOrder.LayoutOrder
			BtnLayout.Padding = UDim.new(0, 6)
			BtnLayout.Parent = BtnRow

			for i, btnData in ipairs(buttons) do
				local Btn = Instance.new("TextButton")
				Btn.Size = UDim2.new(1 / #buttons, -6 * (#buttons - 1) / #buttons, 1, 0)
				Btn.BackgroundColor3 = Theme.ButtonBackground
				Btn.BorderSizePixel = 0
				Btn.Text = btnData.Text or ("Button " .. i)
				Btn.Font = Theme.Font
				Btn.TextSize = 12
				Btn.TextColor3 = Theme.ButtonTextColor
				Btn.AutoButtonColor = false
				Btn.Modal = true
				Btn.LayoutOrder = i
				Btn.ZIndex = 7
				Btn.Parent = BtnRow

